generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String           @id @default(cuid())
  name             String
  nim              String           @unique
  email            String?
  password         String
  role             String           @default("ANGGOTA")
  avatar           String?
  isActive         Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @default(now()) @updatedAt
  absensiKegiatan  AbsensiAnggota[] @relation("AbsensiUser")
  agendaDibuat     Agenda[]
  anggota          Anggota?
  arsipDiunggah    Arsip[]
  beritaDibuat     Berita[]
  keuanganDicatat  Keuangan[]
  pengurus         Pengurus?
  presensiDiunggah PresensiFoto[]
}

model Anggota {
  id             String           @id @default(cuid())
  userId         String?          @unique
  nim            String           @unique
  nama           String
  prodi          String
  angkatan       String
  noHp           String?
  foto           String?
  divisi         String?
  status         String           @default("Aktif")
  periode        String?
  tanggalGabung  DateTime         @default(now())
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @default(now()) @updatedAt
  alamat         String?
  tanggalLahir   DateTime?
  user           User?            @relation(fields: [userId], references: [id])
  keuangan       Keuangan[]
  komentarBarang KomentarBarang[]
}

model Pengurus {
  id           String    @id @default(cuid())
  userId       String?   @unique
  nama         String
  nim          String?
 
  noHp         String?
  prodi        String?
  alamat       String?
  tanggalLahir DateTime?
  jabatan      String
  kodeJabatan  String    @default("KADIV")
  kelompok     String    @default("Lainnya")
  divisi       String?
  foto         String?
  periodeMulai String
  periodeAkhir String?
  urutan       Int       @default(0)
  isActive     Boolean   @default(true)
  status       String    @default("Aktif")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt
  user         User?     @relation(fields: [userId], references: [id])
  keuangan     Keuangan[]
}

model KategoriBerita {
  id     String   @id @default(cuid())
  nama   String   @unique
  slug   String   @unique
  berita Berita[]
}

model Berita {
  id          String          @id @default(cuid())
  judul       String
  slug        String          @unique
  ringkasan   String
  konten      String
  gambar      String?
  kategoriId  String?
  penulisId   String?
  isPublished Boolean         @default(false)
  dilihat     Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @default(now()) @updatedAt
  kategori    KategoriBerita? @relation(fields: [kategoriId], references: [id])
  penulis     User?           @relation(fields: [penulisId], references: [id])

  @@index([kategoriId])
  @@index([penulisId])
}

model Galeri {
  id        String   @id @default(cuid())
  judul     String
  gambar    String
  kategori  String?
  createdAt DateTime @default(now())
}

model Agenda {
  id             String           @id @default(cuid())
  judul          String
  slug           String           @unique
  deskripsi      String
  lokasi         String
  tanggalMulai   DateTime
  tanggalSelesai DateTime
  gambar         String?
  status         String           @default("AKAN_DATANG")
  kuota          Int?
  penyelenggara  String?
  dibuatOlehId   String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @default(now()) @updatedAt
  absensiAnggota AbsensiAnggota[]
  dibuatOleh     User?            @relation(fields: [dibuatOlehId], references: [id])
  presensiFoto   PresensiFoto[]

  @@index([dibuatOlehId])
}

model AbsensiAnggota {
  id         String   @id @default(cuid())
  agendaId   String
  userId     String
  fotoUrl    String?
  status     String   @default("HADIR")
  alasanIzin String?
  keterangan String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt
  agenda     Agenda   @relation(fields: [agendaId], references: [id], onDelete: Cascade)
  user       User     @relation("AbsensiUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([agendaId, userId])
  @@index([agendaId])
  @@index([userId])
}

model PresensiFoto {
  id             String   @id @default(cuid())
  agendaId       String
  fotoUrl        String
  keterangan     String?
  diunggahOlehId String?
  createdAt      DateTime @default(now())
  agenda         Agenda   @relation(fields: [agendaId], references: [id], onDelete: Cascade)
  diunggahOleh   User?    @relation(fields: [diunggahOlehId], references: [id])

  @@index([agendaId])
  @@index([diunggahOlehId])
}

model Prestasi {
  id            String   @id @default(cuid())
  judul         String
  tingkat       String
  peraih        String
  penyelenggara String?
  tahun         Int
  gambar        String?
  keterangan    String?
  createdAt     DateTime @default(now())
}

model Pendaftaran {
  id                String    @id @default(cuid())
  nama              String
  nim               String
  email             String?
  noHp              String
  prodi             String
  angkatan          String
  alamat            String
  tanggalLahir      DateTime
  motivasi          String
  divisiPilihan     String?
  status            String    @default("PENDING")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @default(now()) @updatedAt
  tahap             String    @default("PRADIKSAR")
  tanggalDiksar     DateTime?
  tanggalLulus      DateTime?
  tanggalPradiksar1 DateTime?
  tanggalPradiksar2 DateTime?

  @@index([nim])
  @@index([status])
  @@index([tahap])
}

model Kontak {
  id        String   @id @default(cuid())
  nama      String
  email     String
  subjek    String
  pesan     String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model FileUnduhan {
  id        String   @id @default(cuid())
  judul     String
  kategori  String?
  fileUrl   String
  createdAt DateTime @default(now())
}

model Banner {
  id       String  @id @default(cuid())
  judul    String
  subjudul String?
  gambar   String
  linkUrl  String?
  urutan   Int     @default(0)
  isActive Boolean @default(true)
}

model ProfilUKM {
  id          String   @id @default(cuid())
  namaUKM     String
  logo        String?
  deskripsi   String
  visi        String
  misi        String
  sejarah     String?
  alamat      String?
  email       String?
  telepon     String?
  instagram   String?
  facebook    String?
  youtube     String?
  tiktok      String?
  waGroupLink String?
  updatedAt   DateTime @default(now()) @updatedAt
}

model Arsip {
  id             String   @id @default(cuid())
  judul          String
  kategori       String?
  fileUrl        String
  diunggahOlehId String?
  createdAt      DateTime @default(now())
  diunggahOleh   User?    @relation(fields: [diunggahOlehId], references: [id])

  @@index([diunggahOlehId])
}

model Keuangan {
  id            String   @id @default(cuid())
  jenis         String
  kategori      String
  jumlah        Float
  keterangan    String?
  buktiUrl      String?
  anggotaId     String?
  pengurusId    String?
  status        String   @default("DIVERIFIKASI")
  dicatatOlehId String?
  tanggal       DateTime @default(now())
  createdAt     DateTime @default(now())
  anggota       Anggota? @relation(fields: [anggotaId], references: [id])
  pengurus      Pengurus? @relation(fields: [pengurusId], references: [id])
  dicatatOleh   User?    @relation(fields: [dicatatOlehId], references: [id])

  @@index([anggotaId])
  @@index([pengurusId])
  @@index([dicatatOlehId])
}

model Barang {
  id         String           @id @default(cuid())
  nama       String
  divisi     String?
  jumlah     Int              @default(1)
  kondisi    String           @default("Baik")
  gambar     String?
  keterangan String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @default(now()) @updatedAt
  komentar   KomentarBarang[]
}

model KomentarBarang {
  id        String   @id @default(cuid())
  barangId  String?
  anggotaId String
  jenis     String
  pesan     String
  status    String   @default("BARU")
  createdAt DateTime @default(now())
  anggota   Anggota  @relation(fields: [anggotaId], references: [id], onDelete: Cascade)
  barang    Barang?  @relation(fields: [barangId], references: [id])

  @@index([anggotaId])
  @@index([barangId])
}

model LinkWhatsApp {
  id        String   @id @default(cuid())
  tahap     String   @unique
  link      String
  updatedAt DateTime @default(now()) @updatedAt
}
