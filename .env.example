# Database (Supabase PostgreSQL)
# Ambil dari Supabase > Project settings > Database > Connection string
# Contoh direct connection:
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"
# Contoh pooler (jika pakai Supabase pooler):
# DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="ganti-dengan-random-secret-panjang"

# Vercel Blob (buat Blob store di Vercel > Storage; token ditambahkan otomatis)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Email (SMTP) - Gmail App Password
# 1) Aktifkan 2-Step Verification di akun Google Anda
# 2) Buat App Password
# 3) Isi email Gmail dan App Password di bawah
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="yourgmail@gmail.com"
SMTP_PASSWORD="16-digit-app-password"
SMTP_FROM="UKM Kampus <yourgmail@gmail.com>"

# Upload
UPLOAD_DIR="public/uploads"
