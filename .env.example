# Database (Supabase PostgreSQL)
# Ambil dari Supabase > Project settings > Database > Connection string
# Contoh direct connection:
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"
# Contoh pooler (jika pakai Supabase pooler):
# DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="ganti-dengan-random-secret-panjang"

# Email (SMTP) - untuk notifikasi pendaftaran anggota diterima
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="email-ukm@gmail.com"
SMTP_PASSWORD="app-password-gmail"
SMTP_FROM="UKM Kampus <email-ukm@gmail.com>"

# Upload
UPLOAD_DIR="public/uploads"
